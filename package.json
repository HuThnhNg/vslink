{
	"name": "vslink",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"description": "VSLink — nhận dạng và học Ngôn ngữ Ký hiệu Việt Nam ngay trên trình duyệt",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"tai-nguyen": "node scripts/chep-tai-nguyen.mjs",
		"tai-mo-hinh": "node scripts/tai-mo-hinh.mjs",
		"predev": "node scripts/chep-tai-nguyen.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/chep-tai-nguyen.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"worker": "cd worker && npx --yes wrangler@4 dev --port 8787"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"@mediapipe/tasks-vision": "1.0.1",
		"onnxruntime-web": "1.30.0"
	}
}
